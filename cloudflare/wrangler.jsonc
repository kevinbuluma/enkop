// Deploy config for the ENKOP master backend on Cloudflare. Lovable never reads this file.
// Deploy: npm run deploy:cloudflare (build, install cloudflare/entry.mjs, wrangler deploy --keep-vars)
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "enkop",
  "main": "../.output/server/enkop-entry.mjs",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  // Keep workers.dev so the old URL can 301 to the apex (entry.mjs).
  "workers_dev": true,
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.mjs", "**/*.js"] }],
  "assets": { "binding": "ASSETS", "directory": "../.output/public", "run_worker_first": ["/videos/*"] },
  "observability": { "enabled": true },
  // The master database: ENKOP's Supabase project (enkop, eu-west-2) through Hyperdrive.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "97f8ef23492148118bf2f4c00a9bf565" }],
  // Legacy D1 master and KV media, kept read-only as a rollback (and for the one-time copy scripts).
  "d1_databases": [
    { "binding": "LEGACY_D1", "database_name": "enkop-db", "database_id": "7f5bf83f-992a-42fd-9e94-e80cd3ba1b79", "migrations_dir": "migrations" }
  ],
  "kv_namespaces": [{ "binding": "MEDIA_KV", "id": "602aa349dbf349d4a7ca93ab54849b31" }],
  // src/server/rate-limit.ts: admin sign-in/setup per address and per account, public enquiries
  // (each sends a WhatsApp alert) per address. Per Cloudflare location and approximate.
  "ratelimits": [
    { "name": "SIGNIN_LIMITER", "namespace_id": "4101", "simple": { "limit": 5, "period": 60 } },
    { "name": "ENQUIRY_LIMITER", "namespace_id": "4102", "simple": { "limit": 5, "period": 60 } }
  ],
  // Apex + www: Worker is the origin; Cloudflare creates DNS and certificates.
  "routes": [
    { "pattern": "enkoprealestate.com", "custom_domain": true },
    { "pattern": "www.enkoprealestate.com", "custom_domain": true }
  ],
  "vars": {
    "ENKOP_BRIDGE_URL": "https://enkop-real-estate.lovable.app",
    "ENKOP_MASTER_URL": "https://enkoprealestate.com",
    "ENKOP_SUPABASE_URL": "https://lucrwaoacfjpgujvzmrl.supabase.co",
    "ENKOP_NOTIFY_WHATSAPP": "254707465190"
  }
  // Secrets (wrangler secret put -c cloudflare/wrangler.jsonc <NAME>):
  //   ENKOP_SUPABASE_SERVICE_KEY  service key of the enkop Supabase project (Storage access)
  //   ENKOP_BRIDGE_SECRET  shared with Lovable's bridge
  //   ENKOP_MEDIA_KEY      HMAC key for signed /media links
  //   ENKOP_INTERNAL_KEY   authenticates the enkop-sync cron Worker
  //   META_WA_TOKEN, META_WA_PHONE_ID  direct WhatsApp Cloud API (preferred over Lovable's connector)
  //   META_WA_TEMPLATE     approved template with one body variable; required for business-initiated
  //                        alerts outside a 24-hour chat window (optional META_WA_TEMPLATE_LANG, default en)
  // Email alerts: add "send_email": [{ "name": "EMAIL" }] and the ENKOP_ALERT_FROM / ENKOP_ALERT_TO vars
  // once a domain is onboarded to Cloudflare Email Sending.
}
